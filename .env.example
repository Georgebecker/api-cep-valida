# =========================================================
#  API CEP Valida — variáveis de ambiente
#  Passo 1: copie este arquivo para `.env`
#  Passo 2: preencha com os valores do SEU ambiente
#  NUNCA envie o `.env` para o repositório (está no .gitignore)
# =========================================================

# --- Projeto / caminhos ------------------------------------
PROJETO_NOME=api-cep-valida
PASTA_RAIZ=.
PASTA_DADOS_RAW=data/raw
PASTA_DADOS_PROCESSED=data/processed
PASTA_NOTEBOOKS=notebooks
PASTA_SAIDAS=saidas

# --- Banco de dados (SQL) -----------------------------------
# SQLite (padrão, sem servidor):
DB_URL=sqlite:///data/estudos.db
# PostgreSQL (exemplo):
# DB_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco
DB_ECHO=false

# --- Execução / qualidade -----------------------------------
LOG_NIVEL=INFO
SEMENTE_ALEATORIA=42

# --- API CEP Valida (configuração local, sem segredos) ------
VIA_CEP_BASE_URL=https://viacep.com.br/ws
VIA_CEP_TIMEOUT=3
VIA_CEP_CACHE_TTL=300
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# --- APIs externas (opcionais — preencher só se for usar) ---
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# HF_TOKEN=
